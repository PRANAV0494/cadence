# Documents the variables the API requires. NOTHING LOADS THIS FILE
# AUTOMATICALLY — there is no python-dotenv in the dependencies and no
# load_dotenv() call. Either export the variables, or pass the file explicitly:
#
#   uvicorn cadence.api.main:app --env-file .env
#
# Copy to .env and fill in. .env is gitignored; never commit real values.
# Empty is treated as missing: a blank JWT_SECRET_KEY will not start the API.
#
# There are no defaults in the code. The API refuses to start without these,
# deliberately: this deployment previously shipped its production JWT signing
# key as a CloudFormation parameter default, so every token was signed with a
# string published in the repository.

# ── Required ───────────────────────────────────────────────────

# Signing key for admin JWTs. Generate a fresh one, never reuse an example:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Admin console login.
ADMIN_USERNAME=

# bcrypt hash of the admin password — the hash, never the password itself:
#   python -c "from passlib.context import CryptContext; \
#     print(CryptContext(schemes=['bcrypt']).hash('your-password'))"
ADMIN_PASSWORD_HASH=

# ── Optional ───────────────────────────────────────────────────

# Admin token lifetime in minutes.
TOKEN_EXPIRE_MINUTES=60

# Use an in-memory store instead of DynamoDB. Set true for local development
# and tests; data is lost on restart.
USE_LOCAL_DB=true

# DynamoDB configuration, used only when USE_LOCAL_DB is false.
DYNAMODB_TABLE=KeystrokeSessions
AWS_REGION=ap-southeast-2

# Comma-separated origins allowed by CORS. Do not use "*" with credentials.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
