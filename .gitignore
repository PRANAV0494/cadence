# --- PRIVACY: never commit participant data ---
data/private/
*.participant.csv
keystroke_export_*.csv

# --- large / regenerable model artifacts (use Releases or DVC) ---
*.pkl
*.joblib
!models/network/cicids2017_scaler.pkl
!models/network/cicids2017_xgboost_model.pkl
checkpoints/
models/identity/**/*.pkl

# --- third-party datasets: ship download scripts, not the data ---
data/DSL-StrongPasswordData.csv
data/keyrecs/
data/aalto/

# --- build junk ---
__pycache__/
# setuptools leaves a stale copy of the whole tree under build/lib/, which sat
# inside `git add -A` range. Given this repo's guards exist because a blanket
# stage nearly published participant data, an untracked mirror of the source
# tree should not be one.
build/
*.egg-info/
*.py[cod]
.pytest_cache/
.aws-sam/
lambda_package/
packages/
deploy-full.zip
*.egg-info/
.venv/
venv/

# --- env / secrets ---
.env
.env.*
# the template is committed; real values never are
!.env.example
*.pem
samconfig.local.toml

# stills from the recorder; the committed demo is cadence-demo.webm
docs/demo/*.png

# --- editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# local tooling config
CLAUDE.md
.claude/
